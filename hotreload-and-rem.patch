diff --git a/docker-compose.dev.yml b/docker-compose.dev.yml
new file mode 100644
index 0000000..46ffbf8
--- /dev/null
+++ b/docker-compose.dev.yml
@@ -0,0 +1,32 @@
+# Smart Wardrobe - Dev overlay (hot-reload)
+#
+# Se aplica ENCIMA de docker-compose.yml, nunca solo.
+# NO se carga automáticamente (no se llama docker-compose.override.yml
+# a propósito) para que no pueda colarse jamás en un `--profile prod`.
+#
+# Uso:
+#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile dev up -d
+#   (o: make docker-dev, ver Makefile actualizado)
+
+services:
+  app:
+    volumes:
+      # Bind-mount de código fuente sobre el que ya copió el Dockerfile.
+      # :ro porque uvicorn --reload solo necesita leer/stat los archivos,
+      # nunca escribir en ellos.
+      - ./backend:/app/backend:ro
+      - ./frontend:/app/frontend:ro
+    command:
+      - python
+      - -m
+      - uvicorn
+      - backend.api.main:app
+      - --host
+      - "0.0.0.0"
+      - --port
+      - "7000"
+      - --reload
+      - --reload-dir
+      - /app/backend
+      - --reload-dir
+      - /app/frontend
