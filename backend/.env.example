# Backend Configuration
# Smart Wardrobe - Pydantic Settings

# Server
API_SERVER_IP=0.0.0.0
API_PORT=7000

# Device & Models
DEVICE=cpu
SAM_MODEL_TYPE=vit_b
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

# Storage (dual paths)
IMAGES_RAW_DIR=/app/data/images/raw
IMAGES_PROCESSED_GARMENTS_DIR=/app/data/images/processed/garments
MODELS_CACHE_DIR=/app/data/models_cache

# Database
DATABASE_URL=sqlite:////app/data/db/smart_wardrobe.db

# CORS
CORS_ORIGINS=["*"]

# AI Provider
AI_PROVIDER=local
NIM_API_KEY=