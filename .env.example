# Smart Wardrobe Outfit System - Environment Variables
# Copy this file to .env and customize for your deployment

# ============================================================
# Application Settings
# ============================================================
APP_NAME=Smart Wardrobe Outfit System
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ============================================================
# Server Configuration (for kiosk to connect)
# ============================================================
API_SERVER_IP=http://localhost:8000

# ============================================================
# Database Configuration
# ============================================================
# SQLite (default, file-based)
DATABASE_URL=sqlite:///data/db/smart_wardrobe.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smart_wardrobe

# ============================================================
# File Storage Paths - Dual storage structure
# ============================================================
IMAGES_RAW_DIR=data/images/raw
IMAGES_PROCESSED_GARMENTS_DIR=data/images/processed/garments
IMAGES_PROCESSED_OUTFITS_DIR=data/images/processed/outfits
MODELS_CACHE_DIR=data/models_cache

# ============================================================
# AI Provider Configuration
# ============================================================
# Options: "local" (rule-based), "nim" (NVIDIA NIM API)
AI_PROVIDER=local

# NVIDIA NIM Configuration (required if AI_PROVIDER=nim)
# Get your API key from https://build.nvidia.com/
NIM_API_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your-nim-api-key-here
NIM_MODEL=nvidia/llama-3.1-nemotron-3-ultra

# ============================================================
# Vision Model Configuration
# ============================================================
# SAM (Segment Anything Model)
# Options: vit_h (best, 2.5GB), vit_l (good, 1.2GB), vit_b (fast, 375MB)
SAM_MODEL_TYPE=vit_h
SAM_CHECKPOINT_URL=https://dl.fbaipublicfiles.com/segment_anything/sam_vit_h_4b8939.pth

# CLIP (Contrastive Language-Image Pre-training)
# Options: ViT-B-32, ViT-B-16, ViT-L-14
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

# Device for AI inference
# Options: cuda, cpu, mps (Apple Silicon)
DEVICE=cuda

# ============================================================
# Frontend Configuration
# ============================================================
FRONTEND_DIR=frontend

# ============================================================
# CORS Configuration
# ============================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:8080,http://raspberrypi.local:8000,*

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
SQL_ECHO=false

# ============================================================
# Raspberry Pi Specific (uncomment for Pi deployment)
# ============================================================
# DEVICE=cpu
# SAM_MODEL_TYPE=vit_b
# MEMORY_LIMIT=1G