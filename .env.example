# Smart Wardrobe Outfit System - Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================================
# Application Settings
# ============================================================
APP_NAME=smart-wardrobe
DEBUG=false
API_SERVER_IP=0.0.0.0

# ============================================================
# Database (SQLite - file-based, stored in /app/data/db)
# ============================================================
DATABASE_URL=sqlite:///data/db/smart_wardrobe.db

# ============================================================
# CORS (allow all for kiosk access from any origin)
# ============================================================
CORS_ORIGINS=*

# ============================================================
# Image Storage Paths (inside container /app/data)
# ============================================================
IMAGES_RAW_DIR=/app/data/images/raw
IMAGES_PROCESSED_DIR=/app/data/images/processed
IMAGES_PROCESSED_GARMENTS_DIR=/app/data/images/processed/garments
IMAGES_PROCESSED_OUTFITS_DIR=/app/data/images/processed/outfits

# ============================================================
# AI Provider Configuration
# ============================================================
# Options: local (default), nim (NVIDIA NIM API)
AI_PROVIDER=local

# Device for local inference: cpu, cuda, mps (Apple Silicon)
DEVICE=cpu

# ============================================================
# NVIDIA NIM API (used when AI_PROVIDER=nim)
# Get your API key at https://build.nvidia.com/
# ============================================================
NIM_API_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your_nim_api_key_here
NIM_MODEL=mistralai/mixtral-8x7b-instruct-v0.1

# ============================================================
# Local AI Models (used when AI_PROVIDER=local)
# Models are auto-downloaded on first use to data/models_cache
# ============================================================
# SAM (Segment Anything Model) - for garment segmentation
SAM_MODEL_TYPE=vit_h
SAM_CHECKPOINT_URL=https://dl.fbaipublicfiles.com/segment_anything/sam_vit_h_4b8939.pth

# CLIP - for garment classification
CLIP_MODEL_NAME=ViT-B/32

# ============================================================
# Optional: Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=/app/data/logs/app.log

# ============================================================
# Optional: Backup
# ============================================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7